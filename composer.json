{
    "name": "mezabi/mezabi",
    "config": {
      "vendor-dir": "mezabi/lib/vendor"
    },
    "repositories": [
      {
        "type": "vcs",
        "url": "https://github.com/mpalosse/yasmf"
      }
    ],
    "autoload": {
      "psr-4": {
        "controllers\\": "mezabi/controllers",
        "services\\": "mezabi/services",
        "application\\": "mezabi/application"
      }
    },
    "require": {
      "php": ">=8.4",
      "ext-pdo": "*",
      "yasmf/yasmf": ">=1.6.3"
    }
  }